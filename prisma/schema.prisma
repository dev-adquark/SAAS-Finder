generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum ContentStatus { DRAFT REVIEW PUBLISHED ARCHIVED }
enum LinkType { OFFICIAL AFFILIATE PRICING }
enum SnapshotType { PRICING FEATURE GENERAL }

model Category {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  description String?
  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id String @id @default(cuid())
  slug String @unique
  name String
  tagline String
  description String
  subcategory String?
  rating Float?
  status ContentStatus @default(DRAFT)
  categoryId String
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  officialUrl String
  pricingUrl String?
  bestFor Json
  features Json
  pros Json
  cons Json
  tags Json
  comparison Json
  faqs Faq[]
  snapshots PricingSnapshot[]
  links AffiliateLink[]
  alternativesFrom Alternative[] @relation("productAlternatives")
  alternativesTo Alternative[] @relation("alternativeProduct")
  changelog ChangeLog[]
  refreshes ContentRefresh[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Alternative {
  id String @id @default(cuid())
  productId String
  alternativeId String
  product Product @relation("productAlternatives", fields: [productId], references: [id], onDelete: Cascade)
  alternative Product @relation("alternativeProduct", fields: [alternativeId], references: [id], onDelete: Cascade)
  sortOrder Int @default(0)
  @@unique([productId, alternativeId])
}

model Faq {
  id String @id @default(cuid())
  productId String
  question String
  answer String
  sortOrder Int @default(0)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PricingSnapshot {
  id String @id @default(cuid())
  productId String
  snapshotType SnapshotType @default(PRICING)
  capturedAt DateTime @default(now())
  sourceUrl String?
  summary String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, capturedAt])
}

model AffiliateLink {
  id String @id @default(cuid())
  productId String
  provider String?
  label String
  url String
  active Boolean @default(false)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChangeLog {
  id String @id @default(cuid())
  productId String
  version String
  summary String
  changedAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, changedAt])
}

model ContentRefresh {
  id String @id @default(cuid())
  productId String
  dueAt DateTime
  reason String
  completedAt DateTime?
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([dueAt, completedAt])
}

model SponsorSlot {
  id String @id @default(cuid())
  name String
  label String @default("Sponsored")
  placement String @default("default")
  active Boolean @default(false)
  url String?
  startsAt DateTime?
  endsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id String @id @default(cuid())
  event String
  path String?
  productSlug String?
  placement String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([event, createdAt])
  @@index([productSlug, createdAt])
}
