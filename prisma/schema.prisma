generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum LinkType {
  OFFICIAL
  AFFILIATE
  PRICING
}

enum SnapshotType {
  PRICING
  FEATURE
  GENERAL
}

// Editorial verification state of a pricing snapshot. Only VERIFIED snapshots render publicly.
enum SnapshotStatus {
  PENDING
  VERIFIED
  REJECTED
  SUPERSEDED
}

enum PriceSourceType {
  OFFICIAL_PRICING_PAGE
  VENDOR_CONFIRMATION
  MANUAL_CHECK
  AUTOMATED_DETECTION
}

enum BillingPeriod {
  FREE
  MONTHLY
  ANNUAL
  ONE_TIME
  USAGE
  CUSTOM
}

enum ReviewStatus {
  NOT_STARTED
  IN_PROGRESS
  NEEDS_UPDATE
  REVIEWED
}

model Category {
  id             String           @id @default(cuid())
  name           String           @unique
  slug           String           @unique
  description    String?
  intro          String?
  seoTitle       String?
  seoDescription String?
  sortOrder      Int              @default(0)
  products       Product[]
  faqs           Faq[]
  useCases       UseCase[]
  pairs          CompetitorPair[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Product {
  id                  String            @id @default(cuid())
  slug                String            @unique
  name                String
  vendor              String?
  tagline             String
  description         String
  subcategory         String?
  status              ContentStatus     @default(DRAFT)
  categoryId          String
  category            Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  officialUrl         String
  pricingUrl          String?
  features            Json
  comparison          Json
  alternativesIntro   String?
  seoTitle            String?
  seoDescription      String?
  // Manual override of the default 90-day freshness target.
  refreshIntervalDays Int?
  // Set when an editor confirms pricing against the vendor, even when nothing changed.
  pricingCheckedAt    DateTime?
  // Editorial content timestamp (distinct from row updatedAt and pricing capture dates).
  contentUpdatedAt    DateTime          @default(now())
  publishedAt         DateTime?
  review              ReviewMetadata?
  tags                ProductTag[]
  faqs                Faq[]
  snapshots           PricingSnapshot[]
  links               AffiliateLink[]
  alternativesFrom    Alternative[]     @relation("productAlternatives")
  alternativesTo      Alternative[]     @relation("alternativeProduct")
  pairsAsA            CompetitorPair[]  @relation("pairProductA")
  pairsAsB            CompetitorPair[]  @relation("pairProductB")
  useCases            UseCaseProduct[]
  changelog           ChangeLog[]
  refreshes           ContentRefresh[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([categoryId, status])
  @@index([status])
}

model ReviewMetadata {
  id               String       @id @default(cuid())
  productId        String       @unique
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating           Float?
  editorialSummary String
  verdict          String?
  pros             Json
  cons             Json
  bestFor          Json
  limitations      Json
  reviewStatus     ReviewStatus @default(NOT_STARTED)
  reviewedBy       String?
  lastReviewedAt   DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Tag {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

// Curated alternatives set: one row per (source product, alternative) with editorial rationale.
// The category is derived from the source product.
model Alternative {
  id            String   @id @default(cuid())
  productId     String
  alternativeId String
  useCaseId     String?
  product       Product  @relation("productAlternatives", fields: [productId], references: [id], onDelete: Cascade)
  alternative   Product  @relation("alternativeProduct", fields: [alternativeId], references: [id], onDelete: Cascade)
  useCase       UseCase? @relation(fields: [useCaseId], references: [id], onDelete: SetNull)
  sortOrder     Int      @default(0)
  rationale     String   @default("")
  keyDifference String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([productId, alternativeId])
  @@index([alternativeId])
}

// Canonical comparison pair. productA always has the alphabetically smaller slug; the migration
// also adds a LEAST/GREATEST unique index so a reversed duplicate cannot be inserted.
model CompetitorPair {
  id         String   @id @default(cuid())
  slug       String   @unique
  productAId String
  productBId String
  categoryId String
  productA   Product  @relation("pairProductA", fields: [productAId], references: [id], onDelete: Cascade)
  productB   Product  @relation("pairProductB", fields: [productBId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  active     Boolean  @default(true)
  summary    String
  chooseA    String
  chooseB    String
  highlights Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productAId, productBId])
  @@index([productBId])
  @@index([categoryId])
}

model UseCase {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  audience         String
  intro            String
  criteria         Json
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status           ContentStatus    @default(DRAFT)
  seoTitle         String?
  seoDescription   String?
  contentUpdatedAt DateTime         @default(now())
  products         UseCaseProduct[]
  faqs             Faq[]
  alternatives     Alternative[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([categoryId, status])
}

model UseCaseProduct {
  id        String   @id @default(cuid())
  useCaseId String
  productId String
  useCase   UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int      @default(0)
  rationale String
  caveat    String?
  active    Boolean  @default(true)

  @@unique([useCaseId, productId])
  @@index([productId])
}

// Exactly one of productId / categoryId / useCaseId is set (enforced by a CHECK constraint).
model Faq {
  id         String    @id @default(cuid())
  productId  String?
  categoryId String?
  useCaseId  String?
  question   String
  answer     String
  sortOrder  Int       @default(0)
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  useCase    UseCase?  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([categoryId])
  @@index([useCaseId])
}

model PricingSnapshot {
  id            String          @id @default(cuid())
  productId     String
  snapshotType  SnapshotType    @default(PRICING)
  plan          String?
  price         Decimal?        @db.Decimal(12, 2)
  currency      String?         @db.VarChar(3)
  billingPeriod BillingPeriod?
  capturedAt    DateTime        @default(now())
  sourceUrl     String?
  sourceType    PriceSourceType @default(MANUAL_CHECK)
  status        SnapshotStatus  @default(PENDING)
  verifiedAt    DateTime?
  verifiedBy    String?
  // Note or change summary.
  summary       String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, capturedAt])
  @@index([status, productId])
}

model AffiliateLink {
  id         String    @id @default(cuid())
  productId  String
  provider   String?
  label      String
  url        String
  active     Boolean   @default(false)
  verifiedAt DateTime?
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([productId, active])
}

model ChangeLog {
  id        String   @id @default(cuid())
  productId String
  version   String
  summary   String
  changedAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, changedAt])
}

model ContentRefresh {
  id          String    @id @default(cuid())
  productId   String
  dueAt       DateTime
  reason      String
  completedAt DateTime?
  resolution  String?
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([dueAt, completedAt])
  @@index([productId, completedAt])
}

model SponsorSlot {
  id          String    @id @default(cuid())
  title       String
  label       String    @default("Sponsored")
  description String?
  pageType    String    @default("product")
  placement   String    @default("sidebar")
  priority    Int       @default(0)
  campaign    String?
  active      Boolean   @default(false)
  url         String?
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([pageType, placement, active])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  event       String
  path        String?
  productSlug String?
  placement   String?
  pageType    String?
  pageSlug    String?
  ctaType     String?
  sponsorId   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([event, createdAt])
  @@index([productSlug, createdAt])
  @@index([createdAt])
}
