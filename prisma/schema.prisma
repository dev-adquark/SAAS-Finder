generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need session-level features (advisory locks, multi-statement transactions) that
  // Supabase's transaction-mode pooler (DATABASE_URL, port 6543) doesn't support. DIRECT_URL should
  // point at the same database via the session pooler (port 5432, no ?pgbouncer=true) instead —
  // fine for the one-off connection a migration needs, unlike the app's runtime query volume.
  directUrl = env("DIRECT_URL")
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum LinkType {
  OFFICIAL
  AFFILIATE
  PRICING
}

enum SnapshotType {
  PRICING
  FEATURE
  GENERAL
}

// Editorial verification state of a pricing snapshot. Only VERIFIED snapshots render publicly.
enum SnapshotStatus {
  PENDING
  VERIFIED
  REJECTED
  SUPERSEDED
}

enum PriceSourceType {
  OFFICIAL_PRICING_PAGE
  VENDOR_CONFIRMATION
  MANUAL_CHECK
  AUTOMATED_DETECTION
}

enum BillingPeriod {
  FREE
  MONTHLY
  ANNUAL
  ONE_TIME
  USAGE
  CUSTOM
}

enum SourceKind {
  PRICING
  PRODUCT
  DOCUMENTATION
  HELP_CENTER
  SECURITY
  CHANGELOG
  NEWSROOM
  ABOUT
  CONTACT
  INTEGRATIONS
  STATUS
  INDEPENDENT
  PRIVACY
  TERMS
}

// Verification state of a source or sourced fact. Only VERIFIED items are presented as verified.
enum SourceStatus {
  VERIFIED
  NEEDS_VERIFICATION
  EXPIRED
  BROKEN
}

enum RelationshipType {
  AFFILIATE
  SPONSORSHIP
  PARTNERSHIP
  COLLABORATION
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum ReviewStatus {
  NOT_STARTED
  IN_PROGRESS
  NEEDS_UPDATE
  REVIEWED
}

model Category {
  id             String           @id @default(cuid())
  name           String           @unique
  slug           String           @unique
  description    String?
  intro          String?
  seoTitle       String?
  seoDescription String?
  sortOrder      Int              @default(0)
  products       Product[]
  faqs           Faq[]
  useCases       UseCase[]
  pairs          CompetitorPair[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Product {
  id                  String              @id @default(cuid())
  slug                String              @unique
  name                String
  vendor              String?
  tagline             String
  description         String
  subcategory         String?
  status              ContentStatus       @default(DRAFT)
  categoryId          String
  category            Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  officialUrl         String
  pricingUrl          String?
  features            Json
  comparison          Json
  alternativesIntro   String?
  seoTitle            String?
  seoDescription      String?
  // Manual override of the default 90-day freshness target.
  refreshIntervalDays Int?
  // Set when an editor confirms pricing against the vendor, even when nothing changed.
  pricingCheckedAt    DateTime?
  // Editorial content timestamp (distinct from row updatedAt and pricing capture dates).
  contentUpdatedAt    DateTime            @default(now())
  featuresCheckedAt   DateTime?
  sourceCheckedAt     DateTime?
  // Evidenced note such as "prices vary by location"; null when not published by the vendor.
  pricingRegionNote   String?
  publishedAt         DateTime?
  review              ReviewMetadata?
  tags                ProductTag[]
  faqs                Faq[]
  snapshots           PricingSnapshot[]
  links               AffiliateLink[]
  alternativesFrom    Alternative[]       @relation("productAlternatives")
  alternativesTo      Alternative[]       @relation("alternativeProduct")
  pairsAsA            CompetitorPair[]    @relation("pairProductA")
  pairsAsB            CompetitorPair[]    @relation("pairProductB")
  useCases            UseCaseProduct[]
  sources             ProductSource[]
  facts               ProductFact[]
  relationships       BrandRelationship[]
  changelog           ChangeLog[]
  refreshes           ContentRefresh[]
  syncPages           SyncPage[]
  dataChanges         DataChange[]
  g2                  G2Listing?
  // Set when the automated sync created this product from a detected G2 listing.
  autoCreatedAt       DateTime?
  // Logo.dev state verified by the automatic sync: the official hostname Logo.dev has a logo for
  // (null = none), when it was last checked, and consecutive "no logo" results (a logo is only
  // removed after two in a row, so one bad response never drops a valid logo).
  logoDomain          String?
  logoCheckedAt       DateTime?
  logoMisses          Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([categoryId, status])
  @@index([status])
}

model ReviewMetadata {
  id               String       @id @default(cuid())
  productId        String       @unique
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating           Float?
  editorialSummary String
  verdict          String?
  pros             Json
  cons             Json
  bestFor          Json
  limitations      Json
  reviewStatus     ReviewStatus @default(NOT_STARTED)
  reviewedBy       String?
  lastReviewedAt   DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Tag {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

// Curated alternatives set: one row per (source product, alternative) with editorial rationale.
// The category is derived from the source product.
model Alternative {
  id            String   @id @default(cuid())
  productId     String
  alternativeId String
  useCaseId     String?
  product       Product  @relation("productAlternatives", fields: [productId], references: [id], onDelete: Cascade)
  alternative   Product  @relation("alternativeProduct", fields: [alternativeId], references: [id], onDelete: Cascade)
  useCase       UseCase? @relation(fields: [useCaseId], references: [id], onDelete: SetNull)
  sortOrder     Int      @default(0)
  rationale     String   @default("")
  keyDifference String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([productId, alternativeId])
  @@index([alternativeId])
}

// Canonical comparison pair. productA always has the alphabetically smaller slug; the migration
// also adds a LEAST/GREATEST unique index so a reversed duplicate cannot be inserted.
model CompetitorPair {
  id         String   @id @default(cuid())
  slug       String   @unique
  productAId String
  productBId String
  categoryId String
  productA   Product  @relation("pairProductA", fields: [productAId], references: [id], onDelete: Cascade)
  productB   Product  @relation("pairProductB", fields: [productBId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  active     Boolean  @default(true)
  summary    String
  chooseA    String
  chooseB    String
  highlights Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productAId, productBId])
  @@index([productBId])
  @@index([categoryId])
}

model UseCase {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  audience         String
  intro            String
  criteria         Json
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status           ContentStatus    @default(DRAFT)
  seoTitle         String?
  seoDescription   String?
  contentUpdatedAt DateTime         @default(now())
  products         UseCaseProduct[]
  faqs             Faq[]
  alternatives     Alternative[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([categoryId, status])
}

model UseCaseProduct {
  id        String  @id @default(cuid())
  useCaseId String
  productId String
  useCase   UseCase @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int     @default(0)
  rationale String
  caveat    String?
  active    Boolean @default(true)

  @@unique([useCaseId, productId])
  @@index([productId])
}

// Exactly one of productId / categoryId / useCaseId is set (enforced by a CHECK constraint).
model Faq {
  id         String    @id @default(cuid())
  productId  String?
  categoryId String?
  useCaseId  String?
  question   String
  answer     String
  sortOrder  Int       @default(0)
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  useCase    UseCase?  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([categoryId])
  @@index([useCaseId])
}

model PricingSnapshot {
  id              String          @id @default(cuid())
  productId       String
  snapshotType    SnapshotType    @default(PRICING)
  plan            String?
  price           Decimal?        @db.Decimal(12, 2)
  currency        String?         @db.VarChar(3)
  billingPeriod   BillingPeriod?
  capturedAt      DateTime        @default(now())
  sourceUrl       String?
  sourceType      PriceSourceType @default(MANUAL_CHECK)
  status          SnapshotStatus  @default(PENDING)
  verifiedAt      DateTime?
  verifiedBy      String?
  // e.g. "per seat per month, billed annually" — exactly as the vendor states it.
  unit            String?
  perSeat         Boolean         @default(false)
  promotional     Boolean         @default(false)
  regionDependent Boolean         @default(false)
  // Verbatim text from the source page supporting this price.
  evidence        String?
  // Note or change summary.
  summary         String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, capturedAt])
  @@index([status, productId])
}

model AffiliateLink {
  id            String    @id @default(cuid())
  productId     String
  // Affiliate network / programme name.
  provider      String?
  label         String
  url           String
  active        Boolean   @default(false)
  verifiedAt    DateTime?
  partnerStatus String?
  trackingId    String?
  approvedAt    DateTime?
  // Where the partnership was verified (e.g. the network's approval page).
  sourceUrl     String?
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([productId, active])
}

model ChangeLog {
  id        String   @id @default(cuid())
  productId String
  version   String
  summary   String
  changedAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, changedAt])
}

model ContentRefresh {
  id          String    @id @default(cuid())
  productId   String
  dueAt       DateTime
  reason      String
  completedAt DateTime?
  resolution  String?
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([dueAt, completedAt])
  @@index([productId, completedAt])
}

model SponsorSlot {
  id          String    @id @default(cuid())
  title       String
  label       String    @default("Sponsored")
  description String?
  logoUrl     String?
  ctaLabel    String?
  pageType    String    @default("product")
  placement   String    @default("sidebar")
  priority    Int       @default(0)
  campaign    String?
  active      Boolean   @default(false)
  url         String?
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([pageType, placement, active])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  event       String
  path        String?
  productSlug String?
  placement   String?
  pageType    String?
  pageSlug    String?
  ctaType     String?
  sponsorId   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([event, createdAt])
  @@index([productSlug, createdAt])
  @@index([createdAt])
}

model ProductSource {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      SourceKind
  url       String
  name      String
  section   String?
  checkedAt DateTime?
  status    SourceStatus  @default(NEEDS_VERIFICATION)
  notes     String?
  facts     ProductFact[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([productId, url])
  @@index([productId, kind])
}

// One sourced fact per (product, key), e.g. freePlan, platforms, security.
model ProductFact {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String
  evidence  String?
  sourceId  String?
  source    ProductSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  checkedAt DateTime?
  status    SourceStatus   @default(NEEDS_VERIFICATION)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([productId, key])
  @@index([sourceId])
}

// Documented commercial relationships only. Nothing here is implied by a product being reviewed.
model BrandRelationship {
  id               String           @id @default(cuid())
  productId        String?
  product          Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  brand            String
  website          String?
  relationshipType RelationshipType
  agreementStatus  AgreementStatus  @default(DRAFT)
  startDate        DateTime?
  endDate          DateTime?
  sourceUrl        String?
  verifiedBy       String?
  verifiedAt       DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([agreementStatus, endDate])
}

// ---------------- Automated research sync (Apify) ----------------
// Automation never publishes a new value by itself. A run may only re-confirm existing verified
// claims whose verbatim evidence is still present on the official page (bumping check dates);
// every difference becomes a DataChange that an editor accepts, rejects or keeps.

enum SyncTrigger {
  SCHEDULED
  MANUAL_FULL
  MANUAL_PRODUCT
}

enum SyncStatus {
  RUNNING // Apify crawl in flight
  PROCESSING // results being validated and diffed (resumable)
  COMPLETED
  PARTIAL // finished, but some sources were unavailable
  FAILED
}

enum SyncPageStatus {
  OK
  UNAVAILABLE // no result: blocked, timed out or failed after retries
  BLOCKED // anti-bot / captcha / 401-403-429 page
  NOT_FOUND // 404 / 410
  MALFORMED // result failed validation (empty, truncated, off-domain redirect)
}

enum DataChangeKind {
  PRICE_CHANGED
  NEW_PLAN
  PLAN_NOT_FOUND
  FACT_NOT_FOUND
  FACT_CHANGED
  NEW_SOURCE
  SOURCE_NOT_FOUND
  SOURCE_UPDATED
}

enum DataChangeStatus {
  PENDING
  ACCEPTED
  REJECTED
  KEPT // editor kept the existing value
  REVERTED
}

model SyncRun {
  id             String       @id @default(cuid())
  trigger        SyncTrigger
  status         SyncStatus   @default(RUNNING)
  // 25-day cycle key (e.g. "cycle-2026-09-08") for scheduled runs, so re-invoking the daily cron is
  // idempotent. Stored in the column originally named weekKey (weekly schedule), hence the @map.
  cycleKey       String?      @unique @map("weekKey")
  productId      String?
  // 1 = known official URLs, 2 = newly discovered official links being validated,
  // 3 = G2 listings (search + known listings), 4 = G2 details for listings matched in phase 3,
  // 5 = Logo.dev logo verification (no Apify run; processed in resumable batches).
  phase          Int          @default(1)
  apifyRunId     String?      @unique
  apifyDatasetId String?
  attempts       Int          @default(1)
  // Dataset offset already processed in the current phase (resumable processing).
  cursor         Int          @default(0)
  lockedUntil    DateTime?
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  error          String?
  stats          Json         @default("{}")
  pages          SyncPage[]
  changes        DataChange[]

  @@index([status, startedAt])
}

model SyncPage {
  id          String          @id @default(cuid())
  runId       String
  run         SyncRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  phase       Int             @default(1)
  url         String
  // Classified kind for discovered links (phase 2).
  kind        SourceKind?
  status      SyncPageStatus?
  httpStatus  Int?
  contentHash String?
  title       String?
  reason      String?
  fetchedAt   DateTime?
  processedAt DateTime?
  // Per-page outcome: claims checked / re-confirmed ids, used for run statistics and product status.
  outcome     Json?

  @@unique([runId, phase, productId, url])
  @@index([productId, fetchedAt])
}

model DataChange {
  id            String           @id @default(cuid())
  runId         String?
  run           SyncRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  productId     String
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind          DataChangeKind
  // Human-readable field, e.g. "Pricing · Pro (monthly)", "Fact · freePlan", "Source · Security".
  field         String
  // Existing record this change concerns (snapshot, fact or source id).
  targetId      String?
  previousValue String?
  newValue      String?
  sourceUrl     String?
  // Verbatim text from the fetched official page supporting the new value.
  evidence      String?
  // Structured values needed to apply the change (plan, price, currency, period, kind, name...).
  payload       Json?
  // Same detection is never proposed twice; a rejected/kept proposal stays decided.
  dedupeKey     String
  status        DataChangeStatus @default(PENDING)
  detectedAt    DateTime         @default(now())
  lastSeenAt    DateTime         @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?
  note          String?
  // What accepting changed (ids and prior state), so an accepted change can be reverted.
  applied       Json?

  @@index([status, detectedAt])
  @@index([productId, detectedAt])
  @@index([productId, dedupeKey])
}

enum G2ListingStatus {
  ACTIVE
  NOT_FOUND // the listing stopped appearing in G2 results (kept, never deleted)
}

// Third-party source data from G2 (memo23~g2-scraper), matched to a product by G2 slug or official
// domain. Candidates (productId null) are G2 products our catalog does not have yet. This is source
// data only: editorial scores and published prices never come from here.
model G2Listing {
  id                  String          @id @default(cuid())
  g2Slug              String          @unique
  productId           String?         @unique
  product             Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  status              G2ListingStatus @default(ACTIVE)
  name                String
  vendorName          String?
  g2Url               String
  companyDomain       String?
  companyWebsite      String?
  description         String?
  imageUrl            String?
  // Out of 5; null when G2 reports no rating.
  rating              Float?
  reviewCount         Int?
  pricingType         String?
  categories          Json            @default("[]")
  pricing             Json?
  competitors         Json?
  reviewSummary       Json?
  recentReviews       Json?
  // G2's own freshness stamp for the data, when provided.
  dataAsOf            DateTime?
  // Candidates only: how many catalog products list this as a G2 competitor, and in which category.
  mentions            Int             @default(0)
  candidateCategoryId String?
  // Official-domain disagreement with the matched product (the official URL is never changed from G2).
  domainConflict      Boolean         @default(false)
  contentHash         String?
  firstSeenAt         DateTime        @default(now())
  lastSyncedAt        DateTime        @default(now())
  lastRunId           String?

  @@index([productId])
  @@index([status])
}
