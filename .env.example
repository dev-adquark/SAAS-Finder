# Copy to .env.local for development. Never commit real values.

# PostgreSQL (Supabase / Neon / any Postgres 14+). For serverless, prefer the provider's pooled
# connection string (e.g. Supabase transaction pooler on port 6543 with ?pgbouncer=true).
# Without DATABASE_URL the public site renders the bundled editorial seed content read-only.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Required at build time: `npm run build` now runs `prisma migrate deploy` before building, so
# schema changes are applied automatically on every deploy instead of needing a manual SQL step.
# Migrations need session-level features a transaction-mode pooler (DATABASE_URL, port 6543)
# doesn't support, so this must point at the same database via a non-transaction-pooled connection
# instead — for Supabase, the session pooler on port 5432 (same host/user as DATABASE_URL, just
# port 5432 and no ?pgbouncer=true). Missing this fails the build, on purpose: better to block a
# deploy than ship code expecting columns the database doesn't have yet.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Canonical production origin, no trailing slash. Required in production builds. Production: https://findmy.tech
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
# Optional: old hosts that permanently redirect to NEXT_PUBLIC_SITE_URL (comma-separated; /api/* excluded).
# Default: saas-finder-reviews-delta.vercel.app,www.findmy.tech
# LEGACY_SITE_HOSTS=""

# Admin UI password and admin API bearer token. At least 16 characters; generate with:
#   openssl rand -base64 32
ADMIN_API_KEY=""

# Secret for /api/cron/content-refresh. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# Optional: monitored inbox shown on /contact. While unset, /contact is noindex and not in the sitemap.
CONTACT_EMAIL=""

# Optional: automatic data sync (Apify). Server-side only — never prefix with NEXT_PUBLIC_.
# Without it the sync is disabled and the admin Data Sync page says so. The daily cron
# (/api/cron/apify-sync, authenticated with CRON_SECRET) starts one sync per 31-day cycle:
# the official-website crawl, then G2, then Logo.dev logo verification (each runs only when configured).
APIFY_API_TOKEN=""
# Optional override of the official-site crawler actor (default: apify~playwright-scraper).
# APIFY_ACTOR_ID=""
# Optional override of the G2 actor (default: memo23~g2-scraper). Set APIFY_G2_ENABLED="false" to skip G2.
# APIFY_G2_ACTOR_ID=""
# APIFY_G2_ENABLED=""

# Optional: company logos from Logo.dev (https://www.logo.dev), looked up by each product's official
# domain. The publishable key is designed to be public (it appears in image URLs). Without it the site
# shows the static icons / generated monograms. The secret key is for server-side Logo.dev API calls
# only; the site does not currently use it — never prefix it with NEXT_PUBLIC_.
LOGO_DEV_PUBLISHABLE_KEY=""
# LOGO_DEV_SECRET_KEY=""
